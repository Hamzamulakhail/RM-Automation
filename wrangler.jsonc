{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rm-automation",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "page-poster-db"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "GRAPH_VERSION": "v21.0",
    "MAX_POSTS_PER_RUN": "3"
  },
  "dev": {
    "ip": "0.0.0.0",
    "port": 3000
  }
}
